# Copie para .env.local e preencha.
# No computador (npm run dev) use SEMPRE o Supabase LOCAL: os valores aparecem em `npx supabase status`.
# As chaves do projeto na nuvem ficam só nas variáveis de ambiente da Netlify.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
